rules_version = '2';

// Firestore rules for Instagram Follower Tracker.
// Each authenticated user can read and write only their own data.
// The database is the source of truth for signed-in users:
//   users/{uid}                         -> profile (email, displayName) + settings
//   users/{uid}/deactivated/{username}  -> remembered deactivated profiles
//   users/{uid}/analyses/{id}           -> analysis metadata
//   users/{uid}/analyses/{id}/items/*   -> username chunks
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'settings', 'createdAt', 'updatedAt'
        ])
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('settings' in request.resource.data)
          || (request.resource.data.settings.keys().hasOnly(['autoSave'])
            && request.resource.data.settings.autoSave is bool))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);

      // Profiles marked as deactivated, document ID = username.
      match /deactivated/{username} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['username', 'markedAt'])
          && request.resource.data.username == username
          && username.matches('^[a-z0-9._]{1,50}$')
          && request.resource.data.markedAt is timestamp;
      }

      // Analysis metadata. The username list is split into chunks in items.
      match /analyses/{analysisId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'createdAt', 'followingCount', 'followersCount', 'notFollowingCount',
            'removedDeactivatedCount', 'truncated', 'chunkCount'
          ])
          && request.resource.data.createdAt is timestamp
          && request.resource.data.followingCount is int
          && request.resource.data.followersCount is int
          && request.resource.data.notFollowingCount is int
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount >= 0
          && request.resource.data.chunkCount <= 400;

        match /items/{chunkId} {
          allow read, delete: if isOwner(uid);

          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['usernames'])
            && request.resource.data.usernames is list
            && request.resource.data.usernames.size() <= 900;
        }
      }
    }
  }
}
